{
    "manifest_version": 2,
    "name": "YT Auto Queue",
    "version": "1.1",
    "description": "Queues YouTube tabs to local downloader",
    "permissions": [
        "tabs",
        "http://127.0.0.1/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_action": {
        "default_title": "YT Auto Queue",
        "default_popup": "popup.html"
    }
}